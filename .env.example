# Copy to .env.local and fill in. Never commit real values.

# --- App (public, inlined into the build) -----------------------------------
# Canonical origin of the site, used for metadata, sitemap and alternates.
NEXT_PUBLIC_SITE_URL=
# Origin of the asset CDN (CloudFront) serving images, logos and documents.
NEXT_PUBLIC_ASSETS_URL=
# production | preview | development. Anything but production is not indexed.
NEXT_PUBLIC_SITE_ENV=
# default | test. "test" freezes shaders for deterministic screenshots; never in production.
NEXT_PUBLIC_RENDER_MODE=

# --- Asset tooling (local only, used by npm run assets:sync) ----------------
# Folder holding the design's source assets (brand/, images/, docs/).
ASSETS_SOURCE_DIR=
AWS_REGION=
AWS_S3_BUCKET=
AWS_CLOUDFRONT_ID=
AWS_CLOUDFRONT_URL=
AWS_CLOUDFRONT_DISTRIBUTION_NAME=
